exports[`chordpro-markup-part-2-shorthand.buz.cpm.txt soprano 1`] = `
{
  "body": "<h6 class="ugsComment">Intro</h6>
<pre class="ugsChords ugsNoLyrics"><code data-chordname="Dm" style="padding-right: 0px;"><strong> <em>Dm</em>   <em>Gm</em>   <em>Dm</em>   <em>Gm</em>   <em>D7</em> </strong></code></pre>
