exports[`defining-extra-chords.mr-ukegeek.cpm.txt soprano 1`] = `
{
  "body": "<h6 class="ugsComment">Intro/Overview</h6>
<pre class="ugsPlain">UkeGeeks "knows" only basic chords (hey, it has more than
160, which is a bunch more than I know), so how do you
teach it new chords?</pre>
<pre class="ugsChords">Easy! Use <code data-chordname="Gm7b5" style="padding-right: 0px;"><strong> <em>Gm7b5</em> </strong></code>the "define" tag</pre>
<h6 class="ugsComment">Same Chord, Different Voicings</h6>
<pre class="ugsChords">Sometimes <code data-chordname="C" style="padding-right: 0px;"><strong> <em>C</em> </strong></code>you want to show
<code data-chordname="C-2pos" style="padding-right: 0px;"><strong> <em>C-2pos</em> </strong></code>Second postion chord diagrams...
And other times <code data-chordname="C-alt" style="padding-right: 0px;"><strong> <em>C-alt</em> </strong></code>recommend an alternate fingering</pre>
<h6 class="ugsComment">...And Did You Know</h6>
<pre class="ugsChords">You can <code data-chordname="Ice" style="padding-right: 0px;"><strong> <em>Ice</em> </strong></code>name your <code data-chordname="Cream" style="padding-right: 0px;"><strong> <em>Cream</em> </strong></code>chords <code data-chordname="Pie" style="padding-right: 0px;"><strong> <em>Pie</em> </strong></code>anything!</pre>
<h6 class="ugsComment">Optional</h6>
<pre class="ugsChords"><code data-chordname="G-alt" style="padding-right: 0px;"><strong> <em>G-alt</em> </strong></code>You don't have to include the "extra" fingers,</pre>
<pre class="ugsPlain">Such as barre chords...
(but it helps)</pre>
",
  "diagrams": "<span class="ugs-diagrams--chord-img"><svg/></span><span class="ugs-diagrams--chord-img"><svg/></span><span class="ugs-diagrams--chord-img"><svg/></span><span class="ugs-diagrams--chord-img"><svg/></span><span class="ugs-diagrams--chord-img"><svg/></span><span class="ugs-diagrams--chord-img"><svg/></span><span class="ugs-diagrams--chord-img"><svg/></span><span class="ugs-diagrams--chord-img"><svg/></span>",
}
`;

